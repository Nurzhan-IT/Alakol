# ==============================================
# ПРОИЗВОДСТВЕННЫЕ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ==============================================

# Django settings
SECRET_KEY=your_super_secret_key_here_min_50_chars_long_for_security
DEBUG=False

# Domain settings
DOMAIN_NAME=your-domain.com

# Database settings (PostgreSQL)
DB_NAME=alakol_hms_prod
DB_USER=alakol_user
DB_PASSWORD=your_strong_database_password
DB_HOST=db
DB_PORT=5432

# Redis settings
REDIS_URL=redis://redis:6379/1

# Robokassa payment settings
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_MERCHANT_PASSWORD_1=your_password_1
ROBOKASSA_MERCHANT_PASSWORD_2=your_password_2
ROBOKASSA_TEST_PASSWORD_1=your_test_password_1
ROBOKASSA_TEST_PASSWORD_2=your_test_password_2

# AWS SES Email settings (optional)
AWS_SES_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
DEFAULT_FROM_EMAIL=noreply@your-domain.com
SERVER_EMAIL=server@your-domain.com

# Monitoring and logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================
# ИНСТРУКЦИИ ПО ИСПОЛЬЗОВАНИЮ
# ==============================================

# 1. Скопируйте этот файл в .env.prod
# 2. Замените все значения на реальные
# 3. Убедитесь, что .env.prod добавлен в .gitignore
# 4. Генерация SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(50))"
# 5. Для Robokassa получите реальные ключи в личном кабинете
# 6. Для AWS SES настройте IAM пользователя с правами отправки писем 